{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd scamshield-frontend && npm install && npm run build",
  "outputDirectory": "scamshield-frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://scamshield-v3.onrender.com/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
